# Copy to .env.local only when configuring manually.
# The Windows first-run setup creates a dedicated gigsy_app account and gigsy_dev database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gigsy_app
DB_PASSWORD=replace_with_your_local_database_password
DB_NAME=gigsy_dev
SESSION_SECRET=replace_with_a_long_random_secret

# Local ChromaDB + Sentence Transformers (no OpenAI API key required)
CHROMA_SERVICE_URL=http://127.0.0.1:8001
CHROMA_SERVICE_TOKEN=replace_with_a_long_random_secret
INDEXING_SECRET=replace_with_another_long_random_secret
